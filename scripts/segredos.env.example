# Copie para scripts/segredos.env e preencha. Esse arquivo NUNCA vai para o GitHub (já está no .gitignore).
# Use aspas simples em todos os valores (a URL do Mongo tem ? e &, a senha do SQL pode ter #).

# mesmos valores do backend/.env
INTERNAL_API_KEY='...'
JWT_SECRET='...'

# MongoDB Atlas (um banco por domínio)
MONGO_URI_USUARIOS='mongodb+srv://USUARIO:SENHA@miaudota.jhxz5gy.mongodb.net/miaudota_usuarios?retryWrites=true&w=majority'
MONGO_URI_ADOCAO='mongodb+srv://USUARIO:SENHA@miaudota.jhxz5gy.mongodb.net/miaudota_adocao?retryWrites=true&w=majority'

# CloudAMQP (campo URL da instância)
RABBITMQ_URL='amqps://usuario:senha@host.cloudamqp.com/vhost'

# Azure SQL
SQL_SERVER='miaudota-sql.database.windows.net'
SQL_DATABASE='miaudota_geolocalizacao'
SQL_USER='sofhia'
SQL_PASSWORD='...'

# Azure Function publicada (URL completa da função + chave)
FUNCTION_URL='https://SEU-APP.azurewebsites.net/api/indicador-adocao'
FUNCTION_KEY='...'

# n8n (e-mail). URL de PRODUÇÃO do webhook (n8n Cloud: Webhook > "Production URL"). Deixe vazio até configurar o n8n.
N8N_WEBHOOK_URL=''
# opcional: se definir, configure o mesmo valor como Header Auth (x-miaudota-token) no webhook do n8n
N8N_WEBHOOK_TOKEN=''
