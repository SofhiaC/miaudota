{
  "name": "miaudota-backend",
  "version": "0.0.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start:usuarios": "node dist/usuarios/main.js",
    "start:adocao": "node dist/adocao/main.js",
    "start:geolocalizacao": "node dist/geolocalizacao/main.js",
    "start:bff": "node dist/bff-mobile/main.js",
    "start:gateway": "node dist/api-gateway/main.js",
    "dev": "concurrently -k -n usuarios,adocao,geo,bff,gateway,notif -c blue,green,yellow,magenta,cyan,red \"node --watch dist/usuarios/main.js\" \"node --watch dist/adocao/main.js\" \"node --watch dist/geolocalizacao/main.js\" \"node --watch dist/bff-mobile/main.js\" \"node --watch dist/api-gateway/main.js\" \"node --watch dist/notificacao/main.js\"",
    "start:all": "npm run build && npm run dev",
    "start:notificacao": "node dist/notificacao/main.js",
    "notificacao:reenviar": "node dist/notificacao/reenviar-descartadas.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.0",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "mongoose": "^8.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0"
  }
}
